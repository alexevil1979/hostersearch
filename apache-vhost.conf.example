# Production example (Ubuntu/Apache + PHP-FPM 8.2)
# Domain: hostsearch.1tlt.ru
# DocumentRoot must point to /public

<VirtualHost *:80>
    ServerName hostsearch.1tlt.ru
    DocumentRoot /ssd/www/hostersearch/public

    <Directory /ssd/www/hostersearch>
        Require all denied
    </Directory>
    <Directory /ssd/www/hostersearch/public>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    <FilesMatch \.php$>
        SetHandler "proxy:unix:/run/php/php8.2-fpm.sock|fcgi://localhost"
    </FilesMatch>

    ErrorLog ${APACHE_LOG_DIR}/hostsearch_error.log
    CustomLog ${APACHE_LOG_DIR}/hostsearch_access.log combined
</VirtualHost>

# SSL is issued on the VPS with certbot (not Cloudflare proxy):
# certbot --apache -d hostsearch.1tlt.ru

# Local XAMPP example:
# ServerName hostsearch.test
# DocumentRoot "C:/Users/1/Documents/hostersearch/public"
